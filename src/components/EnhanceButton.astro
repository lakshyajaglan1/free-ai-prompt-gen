---
// EnhanceButton.astro — One-click rule-based prompt enhancer button
---

<div class="flex items-center gap-3 my-2" id="enhance-button-wrapper">
  <button
    id="btn-enhance-prompt"
    type="button"
    class="btn-secondary-sm gap-2 border-hairline-strong hover:border-ink shadow-sm transition-all duration-200"
    title="Instantly enhance all prompt fields with expert frameworks (No API key required)"
  >
    <span class="inline-block animate-pulse text-violet">✨</span>
    <span class="body-sm-strong text-ink">Auto-Enhance Prompt</span>
  </button>
  
  <div id="enhance-feedback-badge" class="badge hidden bg-link-bg-soft text-link-deep border border-link/20 text-xs px-2.5 py-1 transition-all duration-300">
    <span id="enhance-feedback-text">Enhanced!</span>
  </div>
</div>
