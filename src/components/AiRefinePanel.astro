---
// AiRefinePanel — "Refine with AI" button + AI-refined output alongside original
---

<section id="ai-refine-panel" class="w-full">
  <div class="card" style="border: 1px solid var(--color-hairline);">
    <div class="flex items-center justify-between mb-3">
      <div class="flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-violet)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
        <span class="body-sm-strong text-ink">AI Refine</span>
        <span class="badge" style="font-size: 10px; padding: 1px 6px;">Optional</span>
      </div>
    </div>

    <!-- No key state -->
    <div id="refine-no-key" class="flex items-center gap-2 caption text-mute">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      Add your Gemini API key in
      <button class="text-link hover:underline cursor-pointer" id="refine-open-settings">Settings</button>
      to enable AI refinement.
    </div>

    <!-- Refine button -->
    <button id="btn-refine" class="btn-primary-sm w-full hidden">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
      </svg>
      Refine with AI
    </button>

    <!-- Loading state -->
    <div id="refine-loading" class="hidden flex items-center justify-center gap-2 py-3">
      <div class="spinner"></div>
      <span class="body-sm text-body">Refining your prompt…</span>
    </div>

    <!-- Error state -->
    <div id="refine-error" class="hidden mt-3" style="background: var(--color-error-soft); border-radius: var(--radius-sm); padding: var(--sp-sm) var(--sp-md);">
      <div class="flex items-start gap-2">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-error)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="15" y1="9" x2="9" y2="15"></line>
          <line x1="9" y1="9" x2="15" y2="15"></line>
        </svg>
        <span id="refine-error-text" class="caption" style="color: var(--color-error-deep);"></span>
      </div>
    </div>

    <!-- Refined result -->
    <div id="refine-result" class="hidden mt-3">
      <div class="flex items-center justify-between mb-2">
        <span class="caption-mono text-mute uppercase tracking-wider">AI-Refined Version</span>
        <button id="btn-copy-refined" class="btn-secondary-sm" style="font-size: 12px; height: 28px; padding: 0 8px;">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          Copy
        </button>
      </div>
      <div class="code-surface" style="max-height: 300px; overflow-y: auto; border: 1px solid var(--color-violet-deep); border-radius: var(--radius-md);">
        <pre id="refine-result-text" style="margin: 0; white-space: pre-wrap; word-break: break-word;"></pre>
      </div>
    </div>
  </div>
</section>
