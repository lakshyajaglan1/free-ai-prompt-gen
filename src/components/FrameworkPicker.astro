---
// FrameworkPicker — 4 framework options as selectable cards
---

<section id="framework-picker" class="w-full">
  <div class="flex items-center gap-3 mb-3">
    <span class="caption-mono text-mute uppercase tracking-wider">Framework</span>
    <div class="tooltip-trigger" data-tooltip="Frameworks structure your prompt fields in a proven order. Pick any — you can switch anytime.">?</div>
  </div>
  <div class="flex flex-wrap gap-2">
    <button class="tab-ghost framework-tab" data-framework="RTF" data-active="true">
      <span class="font-medium">RTF</span>
      <span class="hidden sm:inline text-mute ml-1">· Role—Task—Format</span>
    </button>
    <button class="tab-ghost framework-tab" data-framework="CO-STAR">
      <span class="font-medium">CO-STAR</span>
      <span class="hidden sm:inline text-mute ml-1">· Context—Objective—Style—Tone—Audience—Response</span>
    </button>
    <button class="tab-ghost framework-tab" data-framework="TAG">
      <span class="font-medium">TAG</span>
      <span class="hidden sm:inline text-mute ml-1">· Task—Action—Goal</span>
    </button>
    <button class="tab-ghost framework-tab" data-framework="APE">
      <span class="font-medium">APE</span>
      <span class="hidden sm:inline text-mute ml-1">· Action—Purpose—Expectation</span>
    </button>
  </div>
  <p id="framework-description" class="caption text-body mt-2" style="min-height: 16px;">
    The simplest and most versatile framework. Define who the AI should be, what it should do, and how it should format the answer.
  </p>
</section>
