---
// TrustBanner.astro — Social proof and trust stats banner
---

<section class="w-full border-y border-hairline bg-canvas py-5 my-4">
  <div class="mx-auto max-w-6xl px-3 sm:px-4 grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 text-center">
    <div class="flex flex-col items-center">
      <span class="display-md text-ink font-mono font-bold">4 Frameworks</span>
      <span class="caption text-body mt-0.5">RTF · CO-STAR · TAG · APE</span>
    </div>

    <div class="flex flex-col items-center">
      <span class="display-md text-ink font-mono font-bold">100% Free</span>
      <span class="caption text-body mt-0.5">No Credit Card or Sign Up</span>
    </div>

    <div class="flex flex-col items-center">
      <span class="display-md text-ink font-mono font-bold">Local &amp; Private</span>
      <span class="caption text-body mt-0.5">Runs Entirely in Browser</span>
    </div>

    <div class="flex flex-col items-center">
      <span class="display-md text-ink font-mono font-bold">Open Source</span>
      <span class="caption text-body mt-0.5">Community Driven</span>
    </div>
  </div>
</section>
