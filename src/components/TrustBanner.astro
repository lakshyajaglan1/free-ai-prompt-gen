---
// TrustBanner.astro — Social proof and trust stats banner
---

<section class="w-full border-y border-hairline bg-canvas py-6 my-4">
  <div class="mx-auto max-w-6xl px-4 flex flex-wrap items-center justify-around gap-6 text-center">
    <div class="flex flex-col items-center">
      <span class="display-md text-ink font-mono font-bold" id="counter-prompts">50,000+</span>
      <span class="caption text-mute mt-0.5">Prompts Engineered</span>
    </div>
    <div class="h-8 w-px bg-hairline hidden sm:block"></div>

    <div class="flex flex-col items-center">
      <span class="display-md text-ink font-mono font-bold">100% Free</span>
      <span class="caption text-mute mt-0.5">No Credit Card or Sign Up</span>
    </div>
    <div class="h-8 w-px bg-hairline hidden sm:block"></div>

    <div class="flex flex-col items-center">
      <span class="display-md text-ink font-mono font-bold">Local & Private</span>
      <span class="caption text-mute mt-0.5">Runs Entirely in Browser</span>
    </div>
    <div class="h-8 w-px bg-hairline hidden sm:block"></div>

    <div class="flex flex-col items-center">
      <span class="display-md text-ink font-mono font-bold">Open Source</span>
      <span class="caption text-mute mt-0.5">Community Driven Framework</span>
    </div>
  </div>
</section>
