---
// Navbar — sticky top bar with brand, page navigation links, theme toggle & settings gear
const pathname = Astro.url ? Astro.url.pathname : '/';

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about' },
  { name: 'Privacy Policy', href: '/privacy' },
  { name: 'Terms', href: '/terms' },
  { name: 'Contact', href: '/contact' },
];

function isActive(href: string) {
  if (href === '/') {
    return pathname === '/' || pathname === '';
  }
  return pathname.startsWith(href);
}
---

<header id="navbar" class="sticky top-0 z-50 bg-canvas border-b border-hairline transition-colors duration-200" style="height: 64px;">
  <div class="w-full flex items-center justify-between h-full" style="padding: 0 clamp(1rem, 5vw, 4rem);">
    <!-- Left: Brand -->
    <a href="/" class="flex items-center gap-2.5 no-underline group shrink-0" id="nav-brand" aria-label="AI Prompt Generator Home">
      <div class="w-8 h-8 rounded-md flex items-center justify-center bg-ink border border-hairline transition-transform duration-150 group-hover:scale-105">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-on-primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
      </div>
      <span class="body-md-strong text-ink tracking-tight">Free AI Prompt Gen</span>
    </a>

    <!-- Center: Desktop Navigation Links (Visible on home & all pages) -->
    <nav class="hidden md:flex items-center gap-1 bg-canvas-soft p-1 rounded-full border border-hairline" id="desktop-nav-links" aria-label="Main Navigation">
      {navLinks.map((link) => {
        const active = isActive(link.href);
        return (
          <a
            href={link.href}
            class={`body-sm px-3.5 py-1 rounded-full transition-all duration-150 ${
              active
                ? 'bg-ink text-on-primary font-medium shadow-sm'
                : 'text-body hover:text-ink hover:bg-canvas'
            }`}
            aria-current={active ? 'page' : undefined}
          >
            {link.name}
          </a>
        );
      })}
    </nav>

    <!-- Right Cluster: Actions -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Dark mode toggle button -->
      <button
        id="btn-theme-toggle"
        class="btn-icon shrink-0"
        title="Toggle Light / Dark theme"
        aria-label="Toggle theme"
      >
        <!-- Sun Icon (shown in dark mode) -->
        <svg id="theme-icon-sun" class="hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <!-- Moon Icon (shown in light mode) -->
        <svg id="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- History / Saved Prompts button -->
      <button
        id="btn-history"
        class="btn-secondary-sm w-9 sm:w-auto px-0 sm:px-3.5 gap-2 shrink-0 justify-center"
        title="Saved Prompts"
        aria-label="Open saved prompts"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span class="hidden sm:inline body-sm-strong whitespace-nowrap">Saved Prompts</span>
      </button>

      <!-- Settings button (API key) -->
      <button
        id="btn-settings"
        class="btn-secondary-sm w-9 sm:w-auto px-0 sm:px-3.5 gap-2 shrink-0 justify-center"
        title="Settings & API Key"
        aria-label="Open settings"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
          <circle cx="7.5" cy="15.5" r="5.5"></circle>
          <path d="m21 2-9.6 9.6"></path>
          <path d="m15.5 7.5 3 3"></path>
          <path d="m18.5 4.5 3 3"></path>
        </svg>
        <span class="hidden sm:inline body-sm-strong whitespace-nowrap">Settings</span>
      </button>

      <!-- Mobile menu hamburger button -->
      <button
        id="btn-mobile-menu"
        class="md:hidden btn-icon shrink-0"
        title="Toggle mobile menu"
        aria-label="Toggle mobile menu"
        aria-expanded="false"
      >
        <svg id="icon-menu-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg id="icon-menu-close" class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation Menu -->
  <div id="mobile-menu" class="hidden md:hidden absolute top-[64px] left-0 right-0 bg-canvas border-b border-hairline shadow-level-4 p-4 z-50">
    <nav class="flex flex-col gap-1.5" aria-label="Mobile Navigation">
      {navLinks.map((link) => {
        const active = isActive(link.href);
        return (
          <a
            href={link.href}
            class={`body-md px-4 py-2.5 rounded-lg transition-colors flex items-center justify-between ${
              active
                ? 'bg-ink text-on-primary font-medium'
                : 'text-body hover:text-ink hover:bg-canvas-soft'
            }`}
          >
            <span>{link.name}</span>
            {active && (
              <span class="w-1.5 h-1.5 rounded-full bg-cyan inline-block"></span>
            )}
          </a>
        );
      })}
    </nav>
  </div>
</header>

<script>
  // Mobile Menu Toggle Script
  const btnMobileMenu = document.getElementById('btn-mobile-menu');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenuOpen = document.getElementById('icon-menu-open');
  const iconMenuClose = document.getElementById('icon-menu-close');

  if (btnMobileMenu && mobileMenu) {
    btnMobileMenu.addEventListener('click', () => {
      const isExpanded = btnMobileMenu.getAttribute('aria-expanded') === 'true';
      btnMobileMenu.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileMenu.classList.toggle('hidden');
      iconMenuOpen?.classList.toggle('hidden');
      iconMenuClose?.classList.toggle('hidden');
    });
  }
</script>
