---
// PromptStats.astro — Live character, word, and token stats counter
---

<div id="prompt-stats-bar" class="flex items-center justify-between gap-2 py-1.5 px-3 bg-canvas-soft border border-hairline rounded-lg text-xs font-mono text-mute mt-2">
  <div class="flex items-center gap-3">
    <span>Words: <strong id="stat-words" class="text-ink font-mono">0</strong></span>
    <span>Chars: <strong id="stat-chars" class="text-ink font-mono">0</strong></span>
  </div>
  <div class="flex items-center gap-1.5">
    <span class="badge py-0 px-2 text-[11px]" id="stat-tokens-badge">~0 Tokens</span>
  </div>
</div>
