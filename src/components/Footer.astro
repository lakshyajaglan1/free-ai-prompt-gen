---
// Footer — structured multi-column navigation footer with brand overview, pages, frameworks & legal links
---

<footer class="border-t border-hairline bg-canvas mt-auto transition-colors duration-200" style="padding: var(--sp-4xl) clamp(1rem, 5vw, 4rem) var(--sp-2xl);">
  <div class="w-full mx-auto" style="max-width: 1200px;">
    <!-- Top Grid: 4 Columns -->
    <div class="grid gap-10 mb-12" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
      
      <!-- Col 1: Brand & Mission -->
      <div class="flex flex-col gap-3">
        <a href="/" class="flex items-center gap-2 no-underline group" aria-label="AI Prompt Generator">
          <div class="w-7 h-7 rounded-lg flex items-center justify-center overflow-hidden transition-transform duration-150 group-hover:scale-105 shadow-sm">
            <svg viewBox="0 0 600 600" class="w-full h-full" aria-hidden="true">
              <rect width="600" height="600" rx="130" fill="#000000" />
              <rect x="177.5" y="177.5" width="245" height="245" rx="42" fill="none" stroke="#ffffff" stroke-width="33" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M 257 230 L 344 300 L 257 370" fill="none" stroke="#ffffff" stroke-width="33" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <span class="body-md-strong text-ink">AI Prompt Gen</span>
        </a>
        <p class="body-sm text-body leading-relaxed">
          The free, privacy-first AI prompt generator and engineering wizard. Craft optimal prompts for ChatGPT, Claude, Gemini &amp; Midjourney locally in your browser.
        </p>
        <div class="flex items-center gap-2 mt-1">
          <span class="badge" style="font-size: 11px; padding: 2px 8px;">100% Client-Side</span>
          <span class="badge" style="font-size: 11px; padding: 2px 8px;">Zero Telemetry</span>
        </div>
      </div>

      <!-- Col 2: Navigation & Legal Pages -->
      <div class="flex flex-col gap-3">
        <div class="caption-mono text-mute uppercase tracking-wider font-semibold">PAGES &amp; LEGAL</div>
        <ul class="flex flex-col gap-2 list-none p-0 m-0 body-sm">
          <li>
            <a href="/" class="text-body hover:text-ink no-underline transition-colors">Home</a>
          </li>
          <li>
            <a href="/about" class="text-body hover:text-ink no-underline transition-colors">About Us</a>
          </li>
          <li>
            <a href="/privacy" class="text-body hover:text-ink no-underline transition-colors">Privacy Policy</a>
          </li>
          <li>
            <a href="/terms" class="text-body hover:text-ink no-underline transition-colors">Terms &amp; Conditions</a>
          </li>
          <li>
            <a href="/contact" class="text-body hover:text-ink no-underline transition-colors">Contact Us</a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Prompt Frameworks -->
      <div class="flex flex-col gap-3">
        <div class="caption-mono text-mute uppercase tracking-wider font-semibold">FRAMEWORKS &amp; GUIDES</div>
        <ul class="flex flex-col gap-2 list-none p-0 m-0 body-sm">
          <li>
            <a href="/#wizard" class="text-body hover:text-ink no-underline transition-colors">RTF (Role-Task-Format)</a>
          </li>
          <li>
            <a href="/#wizard" class="text-body hover:text-ink no-underline transition-colors">CO-STAR Framework</a>
          </li>
          <li>
            <a href="/#wizard" class="text-body hover:text-ink no-underline transition-colors">TAG &amp; APE Frameworks</a>
          </li>
          <li>
            <a href="/#before-after-section" class="text-body hover:text-ink no-underline transition-colors">Before &amp; After Examples</a>
          </li>
          <li>
            <a href="/#faq-section" class="text-body hover:text-ink no-underline transition-colors">Prompt Engineering FAQ</a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Supported Models & Technology -->
      <div class="flex flex-col gap-3">
        <div class="caption-mono text-mute uppercase tracking-wider font-semibold">AI MODEL TARGETS</div>
        <ul class="flex flex-col gap-2 list-none p-0 m-0 body-sm">
          <li>
            <a href="/#wizard" class="text-body hover:text-ink no-underline transition-colors">ChatGPT (Markdown Headers)</a>
          </li>
          <li>
            <a href="/#wizard" class="text-body hover:text-ink no-underline transition-colors">Claude (XML Structured Tags)</a>
          </li>
          <li>
            <a href="/#wizard" class="text-body hover:text-ink no-underline transition-colors">Google Gemini (Bold Labels)</a>
          </li>
          <li>
            <a href="/#wizard" class="text-body hover:text-ink no-underline transition-colors">Midjourney &amp; Video AI</a>
          </li>
          <li>
            <a href="/#wizard" class="text-body hover:text-ink no-underline transition-colors">Local Ollama &amp; LM Studio</a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Row: Copyright, Tech stack, Back to Top -->
    <div class="pt-8 border-t border-hairline flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-4 caption text-mute">
        <span>&copy; {new Date().getFullYear()} AI Prompt Generator. <a href="https://github.com/lakshyajaglan1/free-ai-prompt-gen" target="_blank" rel="noopener noreferrer" class="text-link hover:underline">Open source</a> under MIT.</span>
        <span class="hidden sm:inline text-hairline">&middot;</span>
        <span>Built with <a href="https://astro.build" class="text-link hover:underline" target="_blank" rel="noopener noreferrer">Astro</a></span>
      </div>

      <div class="flex items-center gap-4">
        <a
          href="https://github.com/lakshyajaglan1/free-ai-prompt-gen"
          target="_blank"
          rel="noopener noreferrer"
          class="caption text-mute hover:text-ink flex items-center gap-1.5 transition-colors no-underline"
          title="View GitHub Repository"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
          </svg>
          <span>GitHub</span>
        </a>
        <button
          id="btn-back-to-top"
          class="caption text-mute hover:text-ink flex items-center gap-1 transition-colors cursor-pointer"
          title="Scroll to top"
        >
          <span>Back to top</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="19" x2="12" y2="5"></line>
            <polyline points="5 12 12 5 19 12"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </div>
</footer>

<script>
  // Back to Top button
  document.getElementById('btn-back-to-top')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
