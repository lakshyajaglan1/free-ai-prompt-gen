---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PromptHistory from '../../components/PromptHistory.astro';
import ApiKeySettings from '../../components/ApiKeySettings.astro';
import { STARTER_TEMPLATES } from '../../data/templates';
import { GoalCategory } from '../../lib/types';

const allCategories = [
  'All',
  GoalCategory.Writing,
  GoalCategory.Coding,
  GoalCategory.ImageGeneration,
  GoalCategory.VideoGeneration,
  GoalCategory.DataAnalysis,
  GoalCategory.Research,
  GoalCategory.MarketingCopy,
  GoalCategory.Custom,
];

// Schema for programmatic SEO indexing
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': 'Free AI Prompt Templates Library',
  'description': 'Comprehensive library of 45+ battle-tested AI prompt templates for ChatGPT, Claude, Gemini, and Midjourney.',
  'numberOfItems': STARTER_TEMPLATES.length,
  'itemListElement': STARTER_TEMPLATES.map((template, index) => ({
    '@type': 'ListItem',
    'position': index + 1,
    'name': template.title,
    'description': template.seoDescription,
    'url': `https://freeaipromptgen.com/templates/${template.slug}`,
  })),
};
---

<Layout
  title="45+ Free AI Prompt Templates | ChatGPT, Claude & Midjourney Frameworks"
  description="Explore 45+ free battle-tested AI prompt templates for ChatGPT, Claude, Gemini & Midjourney. Structured with RTF, CO-STAR, and TAG frameworks for zero hallucinations."
  canonicalUrl="https://freeaipromptgen.com/templates"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(itemListSchema)} />

  <Navbar />

  <main class="flex-1 w-full bg-canvas-soft">
    <!-- Hero Section -->
    <section class="relative overflow-hidden border-b border-hairline bg-canvas px-4 sm:px-6 md:px-8 py-12 sm:py-16">
      <div class="absolute inset-0 mesh-gradient opacity-40 pointer-events-none" aria-hidden="true"></div>

      <div class="relative mx-auto text-center" style="max-width: 840px;">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-canvas-soft border border-hairline text-link mb-4 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-cyan inline-block animate-pulse"></span>
          <span>45+ PRODUCTION TEMPLATES</span>
        </div>
        <h1 class="display-xl text-ink mb-5 tracking-tight" style="line-height: 1.15;">
          Engineered <span class="gradient-text">AI Prompt Templates</span> for Any Task
        </h1>
        <p class="body-lg text-body mx-auto leading-relaxed mb-8" style="max-width: 680px;">
          Stop wrestling with vague, hallucinating prompts. Browse our crawlable library of 45+ production-ready engineering frameworks for Anthropic Claude, ChatGPT, Google Gemini, and Midjourney.
        </p>

        <!-- Quick Stats Strip -->
        <div class="flex flex-wrap items-center justify-center gap-6 text-sm text-mute pt-2 border-t border-hairline">
          <div class="flex items-center gap-1.5">
            <svg class="text-link" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>45+ Crawlable Templates</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="text-link" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>
            <span>RTF, CO-STAR, TAG, APE</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="text-link" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M8 12h8"></path></svg>
            <span>100% Free & Open Source</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content & Directory -->
    <section class="w-full max-w-7xl mx-auto px-4 sm:px-6 md:px-8 py-10 sm:py-14">
      <!-- Search & Filters Container -->
      <div class="mb-10 space-y-6">
        <!-- Search Box -->
        <div class="relative max-w-2xl mx-auto">
          <input
            id="template-search-input"
            type="text"
            class="form-input pl-11 pr-10 w-full bg-canvas text-ink shadow-sm"
            placeholder="Search 45+ templates (e.g. 'code refactoring', 'claude xml', 'midjourney', 'cold email')..."
            style="height: 50px; border-radius: 9999px;"
            aria-label="Search prompt templates"
          />
          <svg class="absolute left-4 top-4 text-mute pointer-events-none" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <button
            id="btn-clear-search"
            class="absolute right-4 top-4 text-mute hover:text-ink hidden transition-colors"
            title="Clear search"
            aria-label="Clear search"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>

        <!-- Category Filter Pills (Progressive Enhancement) -->
        <div class="flex items-center justify-center flex-wrap gap-2 pt-2" id="category-filter-pills" role="tablist" aria-label="Template categories">
          {allCategories.map((cat, idx) => (
            <button
              type="button"
              class={`category-filter-btn px-4 py-2 rounded-full text-xs sm:text-sm font-medium transition-all duration-150 border ${
                idx === 0
                  ? 'bg-ink text-on-primary border-ink shadow-sm'
                  : 'bg-canvas text-body hover:text-ink hover:border-hairline-strong border-hairline'
              }`}
              data-category={cat}
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
            >
              {cat}
              {cat === 'All' ? ` (${STARTER_TEMPLATES.length})` : ''}
            </button>
          ))}
        </div>
      </div>

      <!-- Live Count Indicator -->
      <div class="flex items-center justify-between mb-6 pb-2 border-b border-hairline">
        <p class="caption text-mute" id="templates-count-text">
          Showing <strong class="text-ink" id="visible-count">{STARTER_TEMPLATES.length}</strong> of {STARTER_TEMPLATES.length} templates
        </p>
        <span class="caption-mono text-xs text-mute uppercase tracking-wider">Indexed Static pSEO Directory</span>
      </div>

      <!-- Statically Rendered Crawlable Templates Grid -->
      <div
        id="templates-grid"
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
      >
        {STARTER_TEMPLATES.map((template) => (
          <article
            class="template-card group bg-canvas border border-hairline hover:border-hairline-strong rounded-xl p-6 flex flex-col justify-between transition-all duration-200 shadow-sm hover:shadow-md"
            data-category={template.category}
            data-framework={template.recommendedFramework}
            data-model={template.recommendedModel}
            data-search={`${template.title} ${template.seoDescription} ${template.recommendedModel} ${template.recommendedFramework} ${template.category}`.toLowerCase()}
          >
            <div>
              <!-- Badges Header -->
              <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-canvas-soft border border-hairline text-ink">
                  {template.category}
                </span>
                <span class="px-2 py-0.5 rounded-full text-xs font-mono font-medium bg-canvas-soft border border-hairline text-mute">
                  {template.recommendedFramework}
                </span>
                <span class="px-2 py-0.5 rounded-full text-xs font-mono font-medium bg-link-bg-soft/40 text-link border border-link/20 ml-auto">
                  {template.recommendedModel}
                </span>
              </div>

              <!-- Title linking to SEO static page for crawlers -->
              <h2 class="text-lg font-semibold text-ink group-hover:text-link transition-colors mb-2 leading-snug">
                <a
                  href={`/templates/${template.slug}`}
                  class="hover:underline focus:outline-none focus:ring-2 focus:ring-link focus:ring-offset-2 rounded"
                >
                  {template.title}
                </a>
              </h2>

              <!-- Description -->
              <p class="body-sm text-body line-clamp-3 mb-4 leading-relaxed">
                {template.seoDescription}
              </p>
            </div>

            <!-- Footer Card Actions -->
            <div class="pt-4 border-t border-hairline flex items-center justify-between gap-3 mt-auto">
              <a
                href={`/templates/${template.slug}`}
                class="text-xs font-medium text-link hover:text-link-deep inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
              >
                <span>View Full Template</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>

              <a
                href={`/?template=${template.slug}`}
                class="btn-primary-sm text-xs py-1.5 px-3 rounded-full shrink-0 inline-flex items-center gap-1"
                title={`Open ${template.title} directly in the prompt builder`}
              >
                <span>Use in Builder</span>
                <span>⚡</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- No Results Empty State -->
      <div id="no-results-state" class="hidden text-center py-16 px-4 bg-canvas border border-hairline rounded-xl my-8">
        <div class="w-12 h-12 rounded-full bg-canvas-soft border border-hairline flex items-center justify-center mx-auto text-mute mb-4">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </div>
        <h3 class="body-md-strong text-ink mb-1">No prompt templates found</h3>
        <p class="body-sm text-mute max-w-md mx-auto mb-6">
          We couldn't find any templates matching your search criteria. Try a different term or clear the filter.
        </p>
        <button id="btn-reset-filters" class="btn-secondary-sm mx-auto">
          Reset All Filters
        </button>
      </div>

      <!-- Bottom pSEO Educational Section -->
      <section class="mt-16 pt-12 border-t border-hairline">
        <div class="max-w-4xl mx-auto text-center mb-10">
          <div class="caption-mono text-link uppercase tracking-wider mb-2">WHY PROGRAMMATIC FRAMEWORKS WORK</div>
          <h2 class="display-md text-ink mb-4">Why Pre-Engineered Prompts Outperform Ad-Hoc Instructions</h2>
          <p class="body-md text-body leading-relaxed">
            Large language models (LLMs) like GPT-4o, Claude 3.5 Sonnet, and Gemini Pro are sensitive to structural framing. Without explicit roles, delimiter tags, and output constraints, models default to generic conversational consensus. Our templates implement proven cognitive architectures:
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
          <div class="bg-canvas border border-hairline rounded-xl p-6 shadow-sm">
            <div class="w-9 h-9 rounded-lg bg-link-bg-soft/50 text-link flex items-center justify-center font-bold mb-3 font-mono">RTF</div>
            <h3 class="body-md-strong text-ink mb-2">Role-Task-Format</h3>
            <p class="body-sm text-body leading-relaxed">
              Establishes expert persona authority, clear execution task, and deterministic output schema (Markdown, JSON, or code).
            </p>
          </div>
          <div class="bg-canvas border border-hairline rounded-xl p-6 shadow-sm">
            <div class="w-9 h-9 rounded-lg bg-cyan-soft/50 text-cyan-deep flex items-center justify-center font-bold mb-3 font-mono">CO-STAR</div>
            <h3 class="body-md-strong text-ink mb-2">CO-STAR Framework</h3>
            <p class="body-sm text-body leading-relaxed">
              Provides Context, Objective, Style, Tone, Audience, and Response requirements for boardroom and enterprise-grade deliverables.
            </p>
          </div>
          <div class="bg-canvas border border-hairline rounded-xl p-6 shadow-sm">
            <div class="w-9 h-9 rounded-lg bg-violet-soft/50 text-violet flex items-center justify-center font-bold mb-3 font-mono">TAG/APE</div>
            <h3 class="body-md-strong text-ink mb-2">Target & Action Systems</h3>
            <p class="body-sm text-body leading-relaxed">
              Anchors generation on goal parameters and expected outputs to eliminate rambling filler phrasing and hallucinations.
            </p>
          </div>
        </div>
      </section>
    </section>
  </main>

  <Footer />

  <PromptHistory />
  <ApiKeySettings />
</Layout>

<script>
  import { saveTheme } from '../../lib/storage';

  // Global settings modal & drawer handlers
  const btnSettings = document.getElementById('btn-settings');
  const btnHistory = document.getElementById('btn-history');
  const settingsModal = document.getElementById('settings-modal');
  const settingsBackdrop = document.getElementById('settings-backdrop');
  const historyDrawer = document.getElementById('history-drawer');
  const historyBackdrop = document.getElementById('history-backdrop');

  if (btnSettings && settingsModal && settingsBackdrop) {
    btnSettings.addEventListener('click', () => {
      document.body.style.overflow = 'hidden';
      settingsModal.classList.remove('hidden');
      settingsBackdrop.classList.remove('hidden');
    });
  }

  if (btnHistory && historyDrawer && historyBackdrop) {
    btnHistory.addEventListener('click', () => {
      document.body.style.overflow = 'hidden';
      historyDrawer.classList.remove('hidden');
      historyBackdrop.classList.remove('hidden');
    });
  }

  // Theme toggle script
  const btnThemeToggle = document.getElementById('btn-theme-toggle');
  const sunIcon = document.getElementById('theme-icon-sun');
  const moonIcon = document.getElementById('theme-icon-moon');

  function updateThemeUI() {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      sunIcon?.classList.remove('hidden');
      moonIcon?.classList.add('hidden');
    } else {
      sunIcon?.classList.add('hidden');
      moonIcon?.classList.remove('hidden');
    }
  }

  btnThemeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      document.documentElement.classList.remove('dark');
      document.documentElement.setAttribute('data-theme', 'light');
      saveTheme('light');
    } else {
      document.documentElement.classList.add('dark');
      document.documentElement.setAttribute('data-theme', 'dark');
      saveTheme('dark');
    }
    updateThemeUI();
  });

  updateThemeUI();

  // ══════════════════════════════════════════════════════════════
  // PROGRESSIVE ENHANCEMENT: CLIENT-SIDE SEARCH & FILTERING
  // ══════════════════════════════════════════════════════════════
  const searchInput = document.getElementById('template-search-input') as HTMLInputElement | null;
  const clearBtn = document.getElementById('btn-clear-search');
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.category-filter-btn');
  const templateCards = document.querySelectorAll<HTMLElement>('.template-card');
  const visibleCountEl = document.getElementById('visible-count');
  const noResultsState = document.getElementById('no-results-state');
  const resetFiltersBtn = document.getElementById('btn-reset-filters');

  let activeCategory = 'All';

  // Check URL query parameters on initial page load (e.g. /templates?category=Coding)
  const urlParams = new URLSearchParams(window.location.search);
  const paramCategory = urlParams.get('category');
  const paramQuery = urlParams.get('q');

  if (paramCategory) {
    activeCategory = paramCategory;
    filterBtns.forEach((btn) => {
      const match = btn.dataset.category?.toLowerCase() === paramCategory.toLowerCase();
      if (match) {
        btn.classList.add('bg-ink', 'text-on-primary', 'border-ink', 'shadow-sm');
        btn.classList.remove('bg-canvas', 'text-body', 'border-hairline');
        btn.setAttribute('aria-selected', 'true');
      } else {
        btn.classList.remove('bg-ink', 'text-on-primary', 'border-ink', 'shadow-sm');
        btn.classList.add('bg-canvas', 'text-body', 'border-hairline');
        btn.setAttribute('aria-selected', 'false');
      }
    });
  }

  if (paramQuery && searchInput) {
    searchInput.value = paramQuery;
    clearBtn?.classList.remove('hidden');
  }

  function filterCards() {
    const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
    let visibleCount = 0;

    templateCards.forEach((card) => {
      const cardCategory = card.dataset.category || '';
      const cardSearchText = card.dataset.search || '';

      const matchesCategory = activeCategory === 'All' || cardCategory.toLowerCase() === activeCategory.toLowerCase();
      const matchesQuery = !query || cardSearchText.includes(query);

      if (matchesCategory && matchesQuery) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (visibleCountEl) {
      visibleCountEl.textContent = String(visibleCount);
    }

    if (noResultsState) {
      if (visibleCount === 0) {
        noResultsState.classList.remove('hidden');
      } else {
        noResultsState.classList.add('hidden');
      }
    }

    if (clearBtn && searchInput) {
      if (searchInput.value.length > 0) {
        clearBtn.classList.remove('hidden');
      } else {
        clearBtn.classList.add('hidden');
      }
    }
  }

  // Category filter clicks
  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = btn.dataset.category || 'All';

      filterBtns.forEach((b) => {
        b.classList.remove('bg-ink', 'text-on-primary', 'border-ink', 'shadow-sm');
        b.classList.add('bg-canvas', 'text-body', 'border-hairline');
        b.setAttribute('aria-selected', 'false');
      });

      btn.classList.add('bg-ink', 'text-on-primary', 'border-ink', 'shadow-sm');
      btn.classList.remove('bg-canvas', 'text-body', 'border-hairline');
      btn.setAttribute('aria-selected', 'true');

      filterCards();
    });
  });

  // Search input events
  searchInput?.addEventListener('input', () => {
    filterCards();
  });

  clearBtn?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      searchInput.focus();
    }
    filterCards();
  });

  resetFiltersBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    activeCategory = 'All';
    filterBtns.forEach((btn, idx) => {
      if (idx === 0) {
        btn.classList.add('bg-ink', 'text-on-primary', 'border-ink', 'shadow-sm');
        btn.classList.remove('bg-canvas', 'text-body', 'border-hairline');
        btn.setAttribute('aria-selected', 'true');
      } else {
        btn.classList.remove('bg-ink', 'text-on-primary', 'border-ink', 'shadow-sm');
        btn.classList.add('bg-canvas', 'text-body', 'border-hairline');
        btn.setAttribute('aria-selected', 'false');
      }
    });
    filterCards();
  });

  // Initial execution in case query params were populated
  if (paramCategory || paramQuery) {
    filterCards();
  }
</script>
