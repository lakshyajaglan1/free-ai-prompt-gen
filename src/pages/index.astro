---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CategoryPicker from '../components/CategoryPicker.astro';
import FrameworkPicker from '../components/FrameworkPicker.astro';
import ModelPicker from '../components/ModelPicker.astro';
import PromptForm from '../components/PromptForm.astro';
import PreviewPanel from '../components/PreviewPanel.astro';
import WhyThisWorksPanel from '../components/WhyThisWorksPanel.astro';
import BeforeAfterToggle from '../components/BeforeAfterToggle.astro';
import PromptHistory from '../components/PromptHistory.astro';
import TemplateLibrary from '../components/TemplateLibrary.astro';
import ApiKeySettings from '../components/ApiKeySettings.astro';
import AiRefinePanel from '../components/AiRefinePanel.astro';
import StepProgress from '../components/StepProgress.astro';
import TrustBanner from '../components/TrustBanner.astro';
import PromptScoreBar from '../components/PromptScoreBar.astro';
import EnhanceButton from '../components/EnhanceButton.astro';
import QuickStartBar from '../components/QuickStartBar.astro';

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  'name': 'Free AI Prompt Generator & Prompt Builder',
  'alternateName': [
    'AI Prompt Generator',
    'Claude XML Prompt Builder',
    'CO-STAR Prompt Generator',
    'Free AI Prompt Writer',
    'ChatGPT Prompt Generator'
  ],
  'url': 'https://freeaipromptgen.com/',
  'applicationCategory': 'UtilitiesApplication',
  'operatingSystem': 'All',
  'offers': {
    '@type': 'Offer',
    'price': '0',
    'priceCurrency': 'USD'
  },
  'description': 'Free AI prompt generator and engineering wizard. Craft optimal text, image & code prompts for ChatGPT, Gemini, Claude & Midjourney using proven RTF, CO-STAR, and XML frameworks.'
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    {
      '@type': 'Question',
      'name': 'What is an AI prompt generator?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'An AI prompt generator is a tool or wizard that helps users structure, format, and optimize text instructions for artificial intelligence models like ChatGPT, Google Gemini, Claude, and Midjourney. It uses proven frameworks like RTF, CO-STAR, and TAG to turn raw ideas into high-performing prompts.'
      }
    },
    {
      '@type': 'Question',
      'name': 'What should I look for in a prompt builder?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Look for a tool that makes its structure clear, supports the models you use, and lets you review the final instruction before copying it. Local processing and optional refinement with your own API key are useful privacy and control features.'
      }
    },
    {
      '@type': 'Question',
      'name': 'How do I write a good prompt for AI?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'To write a good prompt for AI: 1) Define a clear Role (e.g. Senior Copywriter), 2) Provide Context, 3) Specify the Task, 4) Set Constraints (length, tone, style), and 5) Declare the exact Output Format (Markdown headers, XML, JSON, bullet points).'
      }
    },
    {
      '@type': 'Question',
      'name': 'How to write a prompt for an AI video generator?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'To write a prompt for an AI video generator (like Sora, Runway Gen-2, or Pika): 1) Describe the core subject and setting, 2) Specify camera dynamics (pan, tilt, zoom, drone shot), 3) Define lighting and mood (golden hour, volumetric glow), and 4) Detail movement pacing and frame rate expectations.'
      }
    },
    {
      '@type': 'Question',
      'name': 'How to prompt an AI image generator or AI art generator?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'To prompt an AI image or art generator (Midjourney, DALL-E 3, Stable Diffusion): combine subject details ("futuristic cyberpunk city"), art style ("photorealistic, octane render"), lighting & lens settings ("85mm lens, volumetric lighting"), and parameters like aspect ratio (--ar 16:9) and negative prompts.'
      }
    },
    {
      '@type': 'Question',
      'name': 'How to use an AI image generator with a text prompt?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'To use an AI image generator with a text prompt, enter a descriptive text string starting with your subject, followed by visual style cues (medium, camera angle, lighting), and negative keywords. Our AI prompt generator structures these fields into weighted syntax ready to copy into Midjourney or Stable Diffusion.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Can I use a prompt generator for any AI model?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Yes! A quality prompt generator formats outputs for any model target. For example, ChatGPT prefers Markdown headers (## Role, ## Task), Claude excels with XML tags (<role>, <task>), and Gemini responds best to bold parameter blocks (**Role:**).'
      }
    },
    {
      '@type': 'Question',
      'name': 'What is meta-prompting?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Meta-prompting is the technique of using an AI model to write, critique, optimize, or refine prompts for another AI model (or itself). Instead of manually crafting a prompt from scratch, meta-prompting uses AI intelligence to build structured system prompts tailored for optimal execution.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Are there free AI prompt tools?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Yes, there are completely free AI prompt tools available. Our AI Prompt Generator is 100% free and open-source with zero sign-ups, subscriptions, or paywalls. All prompt assembly and framework wizards execute locally in your browser.'
      }
    },
    {
      '@type': 'Question',
      'name': 'How to prompt AI art generator free online?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'You can generate structured image and art prompts online for free using our built-in Image & Visual category wizard. Select the "Image / Visual" category, fill in your subject, style, lighting, and camera angle preferences, and copy the assembled prompt straight into free image generators like Bing Image Creator or Leonardo AI.'
      }
    }
  ]
};
---

<Layout
  title="Free AI Prompt Generator & CO-STAR / Claude XML Prompt Builder (No Login)"
  description="Free AI prompt generator & CO-STAR / Claude XML prompt builder. Craft structured, high-performing prompts for ChatGPT, Claude, Gemini & Midjourney with live scoring and zero login."
  canonicalUrl="https://freeaipromptgen.com/"
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

  <Navbar />

  <main class="flex-1">
    <!-- ════════════════════════════════════
         HERO SECTION
         ════════════════════════════════════ -->
    <section class="relative overflow-hidden px-4 sm:px-6 md:px-8 py-10 sm:py-16 md:py-20">
      <!-- Mesh gradient backdrop -->
      <div class="absolute inset-0 mesh-gradient opacity-70 pointer-events-none" aria-hidden="true"></div>

      <div class="relative mx-auto text-center" style="max-width: 760px;">
        <div class="badge-gradient mb-4 mx-auto" style="width: fit-content;">Free &amp; Open Source &middot; No Login</div>
        <h1 class="display-xl text-ink mb-4" style="line-height: 1.15;">
          Free AI Prompt Generator &amp; CO-STAR / Claude XML Prompt Builder.<br/>
          <span class="gradient-text">(No Login Required)</span>
        </h1>
        <p class="body-lg text-body mb-6 mx-auto" style="max-width: 580px;">
          Build high-performance, hallucination-free prompts for ChatGPT, Claude, Gemini &amp; Midjourney. Master CO-STAR, RTF, and XML prompt frameworks with live scoring.
        </p>
        <div class="flex flex-col min-[440px]:flex-row items-center justify-center gap-3 w-full max-w-xs min-[440px]:max-w-none mx-auto">
          <a href="#wizard" class="btn-primary w-full min-[440px]:w-auto">
            Start building
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="#before-after-section" class="btn-secondary w-full min-[440px]:w-auto">See an example</a>
        </div>
      </div>
    </section>

    <!-- Social proof stats banner -->
    <TrustBanner />

    <!-- Step Progress bar -->
    <StepProgress />

    <!-- ════════════════════════════════════
         QUICK START BAR
         ════════════════════════════════════ -->
    <QuickStartBar />

    <!-- ════════════════════════════════════
         WIZARD SECTION
         ════════════════════════════════════ -->
    <section id="wizard" class="w-full max-w-7xl mx-auto px-4 sm:px-6 md:px-8 py-6 sm:py-12">

      <!-- Step 1: Category -->
      <div class="mb-8">
        <CategoryPicker />
      </div>

      <!-- Step 2: Framework + Model (side by side on desktop) -->
      <div class="grid gap-6 mb-8 grid-cols-1 md:grid-cols-2">
        <FrameworkPicker />
        <ModelPicker />
      </div>

      <!-- Mobile View Switcher Tab Bar (Visible on mobile <960px) -->
      <div class="flex md:hidden items-center justify-center gap-1 bg-canvas-soft p-1 rounded-xl border border-hairline mb-4 w-full" id="mobile-view-switcher">
        <button class="flex-1 py-2 px-3 rounded-lg text-sm font-medium transition-all text-center bg-ink text-on-primary shadow-sm" id="btn-tab-form" type="button">
          📝 Edit Form
        </button>
        <button class="flex-1 py-2 px-3 rounded-lg text-sm font-medium transition-all text-center text-body hover:text-ink" id="btn-tab-preview" type="button">
          👁️ Live Preview &amp; Actions
        </button>
      </div>

      <!-- Step 3: Form + Preview (two-column on desktop) -->
      <div class="grid gap-6" id="wizard-main-grid" style="grid-template-columns: 1fr;">
        <!-- Left column: Form -->
        <div class="flex flex-col gap-6" id="wizard-left-col">
          <PromptForm />
          <EnhanceButton />
        </div>

        <!-- Right column: Preview + Score + Why + AI Refine -->
        <div class="flex flex-col gap-4" id="wizard-right-col">
          <div class="md:sticky md:top-[80px]" style="align-self: flex-start;">
            <div class="flex flex-col gap-4">
              <PromptScoreBar />
              <PreviewPanel />
              <WhyThisWorksPanel />
              <AiRefinePanel />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════
         BEFORE / AFTER SECTION
         ════════════════════════════════════ -->
    <section class="w-full max-w-7xl mx-auto px-4 sm:px-6 md:px-8 pb-10 sm:pb-16">
      <BeforeAfterToggle />
    </section>

    <!-- ════════════════════════════════════
         SEO DOCUMENTATION & GUIDE SECTION
         ════════════════════════════════════ -->
    <section class="w-full border-t border-hairline bg-canvas-soft px-4 sm:px-6 md:px-8 py-12 sm:py-16 md:py-24">
      <div class="mx-auto" style="max-width: 1080px;">
        <div class="text-center mb-12">
          <div class="caption-mono text-mute uppercase tracking-wider mb-2">PROMPT ENGINEERING GUIDE</div>
          <h2 class="display-lg text-ink mb-4">
            Build clearer instructions for <span class="gradient-text">every AI model</span>
          </h2>
          <p class="body-lg text-body mx-auto" style="max-width: 680px;">
            Learn how this tool turns an early idea into a clear brief for ChatGPT, Gemini, Claude, Midjourney, and more.
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-2 mb-12">
          <!-- Overview Card -->
          <div class="card p-5 sm:p-6 border border-hairline bg-canvas">
            <h3 class="display-sm text-ink mb-3 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-primary inline-block"></span>
              What is an AI Prompt Generator?
            </h3>
            <p class="body-sm text-body mb-3 leading-relaxed">
              Models such as ChatGPT, Claude, and Gemini respond better when they receive a clear role, enough context, a concrete task, and an expected format. This generator helps turn a one-line idea into an instruction set that covers those essentials.
            </p>
            <p class="body-sm text-body leading-relaxed">
              Choose RTF for a concise brief, CO-STAR for a fuller communication plan, TAG for goal-oriented work, or APE when the purpose matters most. The wizard shows how each field contributes to the finished prompt and assembles it locally in your browser.
            </p>
          </div>

          <!-- Why Best Tool Card -->
          <div class="card p-5 sm:p-6 border border-hairline bg-canvas">
            <h3 class="display-sm text-ink mb-3 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-link inline-block"></span>
              A transparent way to build prompts
            </h3>
            <p class="body-sm text-body mb-3 leading-relaxed">
              The builder keeps the process visible: you can see the assembled prompt as you work, learn why each field matters, and choose formatting that fits the target model. It runs in the browser and can optionally use an API key you provide for refinement.
            </p>
            <p class="body-sm text-body leading-relaxed">
              Saved prompts, model choices, before-and-after comparisons, and starter templates give developers, marketers, researchers, and creators a practical place to iterate without losing their work.
            </p>
          </div>
        </div>

        <!-- Modalities Breakdown Grid -->
        <div class="mb-12">
          <h3 class="display-md text-ink mb-6 text-center">Supported Modalities: Text, Images, Video &amp; Coding Prompts</h3>
          <div class="grid gap-4 sm:gap-6 grid-cols-1 min-[540px]:grid-cols-2 lg:grid-cols-4">
            <!-- Text & Gemini -->
            <div class="card p-4 sm:p-5 border border-hairline bg-canvas">
              <div class="caption-mono text-link mb-2">01. TEXT &amp; GEMINI</div>
              <h4 class="body-md-strong text-ink mb-2">Text prompts for Gemini and beyond</h4>
              <p class="body-sm text-body leading-relaxed">
                For blogs, emails, research, and analysis, define the audience, point of view, tone, and output format. These details give text models a useful frame for producing an answer you can use.
              </p>
            </div>

            <!-- Image Generation -->
            <div class="card p-4 sm:p-5 border border-hairline bg-canvas">
              <div class="caption-mono text-violet-deep mb-2 font-semibold">02. IMAGE &amp; ART</div>
              <h4 class="body-md-strong text-ink mb-2">Image and art direction</h4>
              <p class="body-sm text-body leading-relaxed">
                Midjourney, Stable Diffusion, and DALL·E benefit from detailed subjects, composition, lighting, palette, camera language, and exclusions. Use the visual category to bring those directions together in one repeatable brief.
              </p>
            </div>

            <!-- Video Generation -->
            <div class="card p-4 sm:p-5 border border-hairline bg-canvas">
              <div class="caption-mono text-warning-deep mb-2 font-semibold">03. VIDEO &amp; MOTION</div>
              <h4 class="body-md-strong text-ink mb-2">Video and motion direction</h4>
              <p class="body-sm text-body leading-relaxed">
                Video tools such as Sora, Runway, and Pika need a subject, setting, camera movement, lighting, and a sense of time. Describe how the scene begins, changes, and ends to make short clips and teasers more predictable.
              </p>
            </div>

            <!-- Coding Prompts -->
            <div class="card p-4 sm:p-5 border border-hairline bg-canvas">
              <div class="caption-mono text-cyan-deep mb-2 font-semibold">04. CODE &amp; REFACTORING</div>
              <h4 class="body-md-strong text-ink mb-2">Coding and refactoring briefs</h4>
              <p class="body-sm text-body leading-relaxed">
                For code, include the language, runtime or framework version, interfaces, success criteria, and edge cases. A structured brief is useful for functions, database schemas, tests, and refactors across coding assistants.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ Section -->
        <div class="card p-5 sm:p-8 border border-hairline bg-canvas" id="faq-section">
          <div class="text-center mb-8">
            <div class="caption-mono text-link mb-2 uppercase tracking-wider">FREQUENTLY ASKED QUESTIONS</div>
            <h3 class="display-md text-ink mb-2">Everything You Need to Know About AI Prompting</h3>
            <p class="body-sm text-body mx-auto" style="max-width: 600px;">
              Got questions about writing prompts, image generation, video prompting, or meta-prompting? Find clear answers below.
            </p>
          </div>

          <div class="grid gap-6 md:grid-cols-2">
            <!-- Q1 -->
            <div class="p-4 rounded-lg border border-hairline bg-canvas-soft">
              <h4 class="body-md-strong text-ink mb-2">What is an AI prompt generator?</h4>
              <p class="body-sm text-body leading-relaxed">
                An AI prompt generator is a tool or wizard that helps users structure, format, and optimize text instructions for artificial intelligence models like ChatGPT, Google Gemini, Claude, and Midjourney. It uses proven frameworks like RTF, CO-STAR, and TAG to turn raw ideas into high-performing prompts.
              </p>
            </div>

            <!-- Q2 -->
            <div class="p-4 rounded-lg border border-hairline bg-canvas-soft">
              <h4 class="body-md-strong text-ink mb-2">What should I look for in a prompt builder?</h4>
              <p class="body-sm text-body leading-relaxed">
                Look for a tool that makes its structure clear, supports the models you use, and lets you review the final instruction before copying it. Local processing and optional refinement with your own API key are useful privacy and control features.
              </p>
            </div>

            <!-- Q3 -->
            <div class="p-4 rounded-lg border border-hairline bg-canvas-soft">
              <h4 class="body-md-strong text-ink mb-2">How do I write a good prompt for AI?</h4>
              <p class="body-sm text-body leading-relaxed">
                To write a good prompt for AI: 1) Define a clear Role (e.g. Senior Copywriter), 2) Provide Context, 3) Specify the Task, 4) Set Constraints (length, tone, style), and 5) Declare the exact Output Format (Markdown headers, XML, JSON, bullet points).
              </p>
            </div>

            <!-- Q4 -->
            <div class="p-4 rounded-lg border border-hairline bg-canvas-soft">
              <h4 class="body-md-strong text-ink mb-2">How to write a prompt for an AI video generator?</h4>
              <p class="body-sm text-body leading-relaxed">
                To write a prompt for an AI video generator (like Sora, Runway Gen-2, or Pika): 1) Describe the core subject and setting, 2) Specify camera dynamics (pan, tilt, zoom, drone shot), 3) Define lighting and mood (golden hour, volumetric glow), and 4) Detail movement pacing and frame rate expectations.
              </p>
            </div>

            <!-- Q5 -->
            <div class="p-4 rounded-lg border border-hairline bg-canvas-soft">
              <h4 class="body-md-strong text-ink mb-2">How to prompt an AI image generator or AI art generator?</h4>
              <p class="body-sm text-body leading-relaxed">
                To prompt an AI image or art generator (Midjourney, DALL-E 3, Stable Diffusion): combine subject details ("futuristic cyberpunk city"), art style ("photorealistic, octane render"), lighting &amp; lens settings ("85mm lens, volumetric lighting"), and parameters like aspect ratio (<code class="font-mono text-xs">--ar 16:9</code>) and negative prompts.
              </p>
            </div>

            <!-- Q6 -->
            <div class="p-4 rounded-lg border border-hairline bg-canvas-soft">
              <h4 class="body-md-strong text-ink mb-2">How to use an AI image generator with a text prompt?</h4>
              <p class="body-sm text-body leading-relaxed">
                To use an AI image generator with a text prompt, enter a descriptive text string starting with your subject, followed by visual style cues (medium, camera angle, lighting), and negative keywords. Our AI prompt generator structures these fields into weighted syntax ready to copy into Midjourney or Stable Diffusion.
              </p>
            </div>

            <!-- Q7 -->
            <div class="p-4 rounded-lg border border-hairline bg-canvas-soft">
              <h4 class="body-md-strong text-ink mb-2">Can I use a prompt generator for any AI model?</h4>
              <p class="body-sm text-body leading-relaxed">
                Yes! A quality prompt generator formats outputs for any model target. For example, ChatGPT prefers Markdown headers (<code class="font-mono text-xs">## Role</code>, <code class="font-mono text-xs">## Task</code>), Claude excels with XML tags (<code class="font-mono text-xs">&lt;role&gt;</code>, <code class="font-mono text-xs">&lt;task&gt;</code>), and Gemini responds best to bold parameter blocks (<code class="font-mono text-xs">**Role:**</code>).
              </p>
            </div>

            <!-- Q8 -->
            <div class="p-4 rounded-lg border border-hairline bg-canvas-soft">
              <h4 class="body-md-strong text-ink mb-2">What is meta-prompting?</h4>
              <p class="body-sm text-body leading-relaxed">
                Meta-prompting is the technique of using an AI model to write, critique, optimize, or refine prompts for another AI model (or itself). Instead of manually crafting a prompt from scratch, meta-prompting uses AI intelligence to build structured system prompts tailored for optimal execution.
              </p>
            </div>

            <!-- Q9 -->
            <div class="p-4 rounded-lg border border-hairline bg-canvas-soft">
              <h4 class="body-md-strong text-ink mb-2">Are there free AI prompt tools?</h4>
              <p class="body-sm text-body leading-relaxed">
                Yes, there are completely free AI prompt tools available. Our AI Prompt Generator is 100% free and open-source with zero sign-ups, subscriptions, or paywalls. All prompt assembly and framework wizards execute locally in your browser.
              </p>
            </div>

            <!-- Q10 -->
            <div class="p-4 rounded-lg border border-hairline bg-canvas-soft">
              <h4 class="body-md-strong text-ink mb-2">How to prompt AI art generator free online?</h4>
              <p class="body-sm text-body leading-relaxed">
                You can generate structured image and art prompts online for free using our built-in Image &amp; Visual category wizard. Select the "Image / Visual" category, fill in your subject, style, lighting, and camera angle preferences, and copy the assembled prompt straight into free image generators like Bing Image Creator or Leonardo AI.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <!-- Overlays (rendered at body level for z-index) -->
  <PromptHistory />
  <TemplateLibrary />
  <ApiKeySettings />
</Layout>

<!-- ═══════════════════════════════════════════════════
     RESPONSIVE GRID (two-column on desktop)
     ═══════════════════════════════════════════════════ -->
<style>
  @media (min-width: 960px) {
    #wizard-main-grid {
      grid-template-columns: 1fr 1fr !important;
    }
  }
</style>

<!-- ═══════════════════════════════════════════════════
     MASTER CLIENT-SIDE SCRIPT
     All wizard interactivity wired here.
     ═══════════════════════════════════════════════════ -->
<script>
  import '../scripts/wizard.ts';
</script>
